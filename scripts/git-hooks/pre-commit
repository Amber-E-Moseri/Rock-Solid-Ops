#!/bin/sh
# Foundation School pre-commit hook (tracked source of truth).
# Install:  cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Legacy CSS migration guardrails (banned in staff/teacher pages):
# - var(--muted)
# - var(--surface)
# - class="chip"
# - class="summary-card"
# - class="badge" (unless fs-badge*)
# Guide: CSS_MIGRATION_GUIDE.md
#
# Policy: reject NEWLY ADDED occurrences only. Unchanged historical lines in a
# touched file do not block a commit.

# Block commits that accidentally include foundation/js/config.js (real credentials).
if git diff --cached --name-only | grep -q "^foundation/js/config\.js$"; then
  echo ""
  echo "ERROR: foundation/js/config.js is staged for commit."
  echo "This file contains real Supabase credentials and must never be committed."
  echo ""
  echo "To unstage it:  git restore --staged foundation/js/config.js"
  echo "To commit without it, use the above command and then retry."
  echo ""
  exit 1
fi

# Block commits containing likely JWT secrets in staged tracked files.
if git diff --cached --name-only | grep -q .; then
  if git diff --cached | grep -qE "eyJ[a-zA-Z0-9_-]{20,}"; then
    echo ""
    echo "ERROR: Staged changes include a JWT-like token prefix (eyJ)."
    echo "Remove secrets from tracked files before committing."
    echo ""
    exit 1
  fi
fi

# Block NEWLY ADDED legacy CSS patterns in staged staff/teacher HTML/CSS.
TARGETS=$(git diff --cached --name-only | grep -E '^foundation/(staff|teacher)/.*\.(html|css)$' || true)
if [ -n "$TARGETS" ]; then
  FOUND=0
  for file in $TARGETS; do
    # Added lines only: keep '+' lines, drop the '+++ b/file' header, strip the marker.
    added_content=$(git diff --cached -U0 --no-color -- "$file" | grep -E '^\+' | grep -vE '^\+\+\+ ' | sed 's/^+//' || true)

    check_pattern() {
      pattern="$1"
      if printf "%s\n" "$added_content" | grep -nF -- "$pattern" >/dev/null; then
        echo "Legacy CSS pattern newly added in $file ($pattern) — use fs-* primitives / --color-* tokens instead."
        FOUND=1
      fi
    }

    check_pattern 'var(--muted)'
    check_pattern 'var(--surface)'
    check_pattern 'class="chip"'
    check_pattern 'class="summary-card"'

    badge_lines=$(printf "%s\n" "$added_content" | grep -nE 'class="[^"]*\bbadge\b[^"]*"' || true)
    if [ -n "$badge_lines" ]; then
      bad_badge_lines=$(printf "%s\n" "$badge_lines" | grep -vE 'fs-badge' || true)
      if [ -n "$bad_badge_lines" ]; then
        echo "Legacy CSS pattern newly added in $file (class=\"badge\") — use fs-badge* instead."
        FOUND=1
      fi
    fi
  done

  if [ "$FOUND" -ne 0 ]; then
    exit 1
  fi
fi

# fs-* migration guard: ban legacy CSS primitives in NEW staged files only.
ADDED_FILES=$(git diff --cached --name-only --diff-filter=A | grep -E '^foundation/.*\.(html|js)$' || true)
if [ -n "$ADDED_FILES" ]; then
  FOUND=0
  for file in $ADDED_FILES; do
    staged_content=$(git show ":$file")
    if printf "%s\n" "$staged_content" | grep -q -e 'var(--muted)' -e 'var(--surface)' -e 'var(--text-secondary)' -e 'class="chip' -e 'class="summary-card' -e '"badge '; then
      echo "ERROR: Legacy CSS primitives detected in newly added file: $file"
      FOUND=1
    fi
  done
  if [ "$FOUND" -ne 0 ]; then
    exit 1
  fi
fi
