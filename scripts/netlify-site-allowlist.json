{
  "description": "Publish guards for the SPA preview build (scripts/build-spa-publish.mjs). The static tree is published by the origin/main baseline (scripts/build-static-publish.mjs), which copies every /foundation page except archive, docs, sql and edge-functions. The SPA is published under /app/. See docs/SPA_CUTOVER_CANDIDATE.md.",
  "spaOutput": "foundation-spa/dist",
  "spaBase": "/app/",
  "externalContract": [
    "/foundation/registration/class-selection.html",
    "/foundation/registration/canada_sr.png",
    "/foundation/staff/TeacherAttendancePortal.html",
    "/foundation/auth/login.html",
    "/foundation/auth/reset-password.html",
    "/foundation/teacher/index.html"
  ],
  "forbiddenFilePatterns": [
    "\\.sql$", "\\.md$", "\\.ts$", "\\.map$", "\\.env", "\\.bak$", "\\.log$", "\\.txt$",
    "(^|/)package(-lock)?\\.json$", "(^|/)node_modules/", "(^|/)src/", "(^|/)archive/", "(^|/)docs/", "(^|/)supabase/"
  ],
  "secretEnvPattern": "SERVICE_ROLE|SECRET|PRIVATE|TOKEN|API_KEY|PASSWORD|BYPASS_ROLE",
  "publicEnvNames": ["SUPABASE_URL", "SUPABASE_ANON_KEY", "VITE_SUPABASE_URL", "VITE_SUPABASE_ANON_KEY", "VITE_VAPID_PUBLIC_KEY", "VAPID_PUBLIC_KEY"]
}
