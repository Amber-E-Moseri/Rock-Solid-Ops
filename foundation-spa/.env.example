# Copy to .env.local and fill in your values.
# Never commit .env.local — it is gitignored.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push (PWA Phase C.2).
# Public VAPID key — safe to ship to the client (bundled by Vite). Generate a pair with
#   npx web-push generate-vapid-keys
# Put the PUBLIC key here, and set the PRIVATE key as a Supabase secret (server-only,
# NEVER a VITE_ var, never committed):
#   supabase secrets set VAPID_PRIVATE_KEY=<private-key>
#   supabase secrets set VAPID_SUBJECT=mailto:ops@yourdomain.com
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Cloudflare Turnstile site key for public teacher account forms. The site key is public. The Turnstile
# SECRET belongs only in Supabase Auth (CAPTCHA protection), never here. Production builds keep those
# forms unavailable while this is empty.
VITE_TURNSTILE_SITE_KEY=

# Dev only: bypass all role checks with this role string (localhost only)
# VITE_BYPASS_ROLE=superadmin
