/supabase/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/ai/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/archive/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/foundation/docs/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/*.sql
  X-Robots-Tag: noindex
  Cache-Control: no-store

/foundation/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://api.resend.com; img-src 'self' data:; frame-ancestors 'none';

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
